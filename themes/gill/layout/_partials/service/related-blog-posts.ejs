<!-- prettier-ignore -->
<%
var filterCategory = (typeof category !== 'undefined' && category) ? category.toString().toLowerCase() : null;
var categoryLabel = filterCategory
	? filterCategory.charAt(0).toUpperCase() + filterCategory.slice(1)
	: null;
var headingText = (typeof heading !== 'undefined' && heading)
	? heading
	: (filterCategory
		? 'Latest ' + filterCategory + ' photography tips and tricks'
		: 'Latest photography tips and tricks');
var subtitleText = (typeof subtitle !== 'undefined' && subtitle)
	? subtitle
	: (filterCategory
		? 'Sharing ' + filterCategory + ' photography tips, behind-the-scenes stories, and more tips and tricks for my ' + filterCategory + ' sessions.'
		: 'Sharing photography tips, behind-the-scenes stories, and more tips and tricks for my sessions.');

var posts = getBlogPosts().toArray();
if (filterCategory) {
	posts = posts.filter(function(post) {
		if (!post.categories || !post.categories.length) return false;
		var matches = false;
		post.categories.forEach(function(cat) {
			if (cat.name && cat.name.toLowerCase() === filterCategory) matches = true;
		});
		return matches;
	});
}
// On a single post page, don't recommend the current article
if (typeof page !== 'undefined' && page && page.layout === 'post' && page.path) {
	posts = posts.filter(function(post) {
		return post.path !== page.path;
	});
}
posts = posts.slice(0, 3);
%>

<% if (posts && posts.length) { %>
<section class="bg-white">
	<div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-6">
		<div class="mx-auto max-w-screen-md text-center mb-8 lg:mb-16">
			<h2 class="mb-4 text-4xl tracking-tight font-light text-gray-900">
				<%= headingText %>
			</h2>
			<p class="font-light text-gray-900 sm:text-xl">
				<%= subtitleText %>
			</p>
		</div>

		<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
			<% posts.forEach(function(post){ %>
			<%
				var postCategoryLabel = categoryLabel;
				if (!postCategoryLabel && post.categories && post.categories.length) {
					post.categories.forEach(function(cat) {
						if (!postCategoryLabel && cat.name) postCategoryLabel = cat.name;
					});
				}
				var ctaLabel = postCategoryLabel
					? 'Read ' + postCategoryLabel + ' photography blog post'
					: 'Read photography blog post';
			%>
			<article
				class="p-4 bg-white border border-gray-200 shadow-md rounded-md flex flex-col h-full"
			>
				<a href="<%= url_for(post.path) %>">
					<img
						class="mb-5 w-full h-48 object-cover rounded-md"
						src="<%= post.featured ? blog_post_asset(post, post.featured) : (post.hero ? blog_post_asset(post, post.hero) : '/img/family.jpg') %>"
						alt="<%= post.title %> | Gill Juergens Photography"
						loading="lazy"
					/>
				</a>

				<div class="flex flex-col flex-grow">
					<h3 class="my-2 text-2xl font-light tracking-tight text-gray-900">
						<a href="<%= url_for(post.path) %>" class="hover:text-gray-700">
							<%= post.title %>
						</a>
					</h3>

					<p class="mb-4 font-light text-gray-500 flex-grow">
						<%= post.excerpt || post.description || post.content.substring(0, 150) + '...' %>
					</p>

					<div class="mt-auto">
						<a
							href="<%= url_for(post.path) %>"
							class="inline-flex items-center px-6 py-3 text-sm font-light text-white bg-gill-green-600 border border-transparent shadow-sm hover:bg-gill-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gill-green-500 transition-colors duration-200 rounded-md"
						>
							<%= ctaLabel %>
						</a>
					</div>
				</div>
			</article>
			<% }); %>
		</div>
	</div>
</section>
<% } %>
