<!-- prettier-ignore -->
<%
// Get the post data from the page object
var postData = page;
%>

<main class="pb-48 lg:pb-60 bg-gill-green-100 antialiased">
	<header class="relative h-[60vh]">
		<div class="absolute inset-0">
			<img
				src="<%= page.hero ? blog_post_asset(page, page.hero) : (page.featured ? blog_post_asset(page, page.featured) : '/img/family.jpg') %>"
				alt="<%= typeof page.title !== 'undefined' && page.title ? page.title : 'Melbourne Photography Tips Post' %> | Gill Juergens Photography"
				class="w-full h-full object-cover"
				loading="lazy"
			/>
			<div class="absolute inset-0 bg-black/60"></div>
		</div>
		<div
			class="absolute top-20 left-1/2 px-4 mx-auto w-full max-w-screen-xl -translate-x-1/2 xl:top-1/2 xl:-translate-y-1/2 xl:px-0"
		>
			<div class="block mb-4 font-light text-gray-300">
				Lifestyle Photographer <span class="text-white">| Melbourne</span>
			</div>
			<h1
				class="mb-4 max-w-4xl text-2xl font-light leading-none text-white sm:text-3xl lg:text-4xl"
			>
				<%= page.title %>
			</h1>
			<% if (page.subtitle) { %>
			<p class="text-lg font-light text-gray-300"><%= page.subtitle %></p>
			<% } %>
		</div>
	</header>

	<div
		class="flex relative z-20 justify-between p-6 -m-36 mx-4 max-w-screen-xl bg-white rounded-md xl:-m-32 xl:p-9 xl:mx-auto"
	>
		<article
			class="xl:w-[828px] w-full max-w-none format format-sm sm:format-base"
		>
			<div class="flex flex-col lg:flex-row justify-between lg:items-center">
				<div
					class="flex items-center space-x-3 text-gray-900 text-base mb-2 lg:mb-0"
				>
					<span
						>By
						<a
							href="<%= url_for('/melbourne-lifestyle-photographer/') %>"
							class="text-gray-900 dark:text-white hover:underline no-underline font-light"
							>Gill Juergens</a
						></span
					>
					<span class="bg-gray-900 w-2 h-2 rounded-full"></span>
					<span
						><time
							class="font-light text-gray-900 uppercase"
							pubdate
							datetime="<%= page.date ? page.date.toISOString() : '' %>"
							title="<%= page.date ? page.date.format('MMMM DD, YYYY') : '' %>"
							><%= page.date ? page.date.format('MMMM DD, YYYY') : '' %></time
						></span
					>
				</div>
			</div>
			<header class="lead"><%= page.description || '' %></header>
			<% if (page.featured) { %>
			<img
				src="<%= blog_post_asset(page, page.featured) %>"
				alt="Melbourne Photographer | Gill Juergens Photography"
				class="w-full h-auto mb-4 rounded-md"
				loading="lazy"
			/>
			<% } %>
			<main class="font-light text-gray-900">
				<%- page.content %>
				<div class="not-format">
					<a
						href="<%= url_for('/book-lifestyle-photographer-in-melbourne/') %>"
						class="text-white bg-primary-900 hover:bg-primary-700 font-light text-sm px-5 py-2.5 mr-2 mb-2 text-center w-full rounded-md"
					>
						Let's chat
					</a>
				</div>
			</main>
		</article>
		<%- include('_partials/sidebar-services') %>
	</div>
</main>

<!-- Recent Photo Shoots Section -->
<!-- prettier-ignore -->
<%- include('_partials/projects-slider', { 
		heading: 'Recent Photo Shoots in Melbourne',
		subtitle: 'Explore my recent work and successful photo shoots in Melbourne and surrounding areas.',
		limit: 6
		}) %>
