<main class="pb-16 lg:pb-24 bg-white antialiased">
	<section class="bg-white">
		<div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-6">
			<div class="mx-auto max-w-screen-sm text-center mb-8 lg:mb-16">
				<h1 class="mb-4 text-4xl tracking-tight font-extrabold text-gray-900">
					Melbourne Photography Tips
				</h1>
				<p class="font-light text-gray-900 sm:text-xl">
					Sharing photography tips, behind-the-scenes stories, and beautiful
					moments from our sessions.
				</p>
			</div>

			<!-- prettier-ignore -->
			<% 
			// Get all blog posts (posts with layout: post)
			var posts = getBlogPosts();
			%>
			<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
				<% posts.each(function(post){ %>
				<%
					var firstCategory = null;
					if (post.categories && post.categories.length) {
						post.categories.forEach(function(category) {
							if (!firstCategory) firstCategory = category;
						});
					}
					var ctaLabel = firstCategory ? 'Read ' + firstCategory.name + ' post' : 'Read post';
				%>
				<article
					class="p-4 bg-white border border-gray-200 shadow-md rounded-md flex flex-col h-full"
				>
					<a href="<%= url_for(post.path) %>">
						<img
							class="mb-5 w-full h-48 object-cover rounded-md"
							src="<%= post.layout === 'post' ? (post.featured ? blog_post_asset(post, post.featured) : (post.hero ? blog_post_asset(post, post.hero) : '/img/family.jpg')) : (post.featured || post.hero || post.thumbnail || post.image || '/img/family.jpg') %>"
							alt="<%= post.title %> | Gill Juergens Photography"
							loading="lazy"
						/>
					</a>

					<div class="flex flex-col flex-grow">
						<h2 class="my-2 text-2xl font-light tracking-tight text-gray-900">
							<a href="<%= url_for(post.path) %>" class="hover:text-gray-700">
								<%= post.title %>
							</a>
						</h2>

						<p class="mb-4 font-light text-gray-500 flex-grow">
							<%= post.excerpt || post.description || post.content.substring(0,
							150) + '...' %>
						</p>

						<div class="mt-auto">
							<a
								href="<%= url_for(post.path) %>"
								class="inline-flex items-center px-6 py-3 text-sm font-light text-white bg-gill-green-600 border border-transparent shadow-sm hover:bg-gill-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gill-green-500 transition-colors duration-200 rounded-md"
							>
								<%= ctaLabel %>
							</a>
						</div>
					</div>
				</article>
				<% }); %>
			</div>

			<% if (posts.length === 0) { %>
			<div class="text-center py-12">
				<p class="text-gray-500 text-lg">
					No photography tips posts found yet. Check back soon!
				</p>
			</div>
			<% } %>
		</div>
	</section>
</main>
